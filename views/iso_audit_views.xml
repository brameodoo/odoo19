<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_iso_audit_form" model="ir.ui.view">
        <field name="name">iso.audit.form</field>
        <field name="model">iso.audit</field>
        <field name="arch" type="xml">
            <form string="Auditoría ISO">
                <header>
                    <button name="action_start" string="Iniciar Auditoría" type="object" invisible="state != 'draft'" class="oe_highlight"/>
                    <button name="action_done" string="Cerrar y Calificar" type="object" invisible="state != 'in_progress'" class="oe_highlight"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,in_progress,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_ncrs" type="object" class="oe_stat_button" icon="fa-warning">
                            <field name="ncr_count" string="NCRs" widget="statinfo"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group name="meta_left">
                            <field name="cdo_id"/>
                            <field name="process_name"/>
                            <field name="procedure_name"/>
                            <field name="format_code"/>
                        </group>
                        <group name="meta_right">
                            <field name="date"/>
                            <field name="time"/>
                            <field name="auditor_id"/>
                            <field name="audited_job_title"/>
                        </group>
                    </group>

                    <!-- Panel de Calificaciones Ponderadas -->
                    <notebook>
                        <page string="Matriz de Calificación (F-CAL-15_R01)" name="scores">
                            <group col="3">
                                <group string="Criterios Organizacionales (30%)">
                                    <field name="org_total_applicable"/>
                                    <field name="org_total_compliant"/>
                                    <field name="org_total_non_compliant"/>
                                    <field name="org_compliance_rate" widget="percentage"/>
                                </group>
                                <group string="Criterios Operativos (70%)">
                                    <field name="op_total_applicable"/>
                                    <field name="op_total_compliant"/>
                                    <field name="op_total_non_compliant"/>
                                    <field name="op_compliance_rate" widget="percentage"/>
                                </group>
                                <group string="Calificación Final">
                                    <div class="text-center">
                                        <h3>Cumplimiento Global</h3>
                                        <h1 class="text-primary"><field name="global_compliance_rate" widget="percentage"/></h1>
                                    </div>
                                </group>
                            </group>
                        </page>

                        <page string="Checklist de Auditoría" name="checklist">
                            <field name="line_ids">
                                <list editable="bottom" decoration-danger="result == 'non_compliant'" decoration-success="result == 'compliant'">
                                    <field name="item_number" width="40px"/>
                                    <field name="criteria_type"/>
                                    <field name="iso_clause"/>
                                    <field name="question"/>
                                    <field name="result" widget="badge" decoration-danger="result == 'non_compliant'" decoration-success="result == 'compliant'"/>
                                    <field name="objective_evidence"/>
                                    <field name="breached_requirement"/>
                                    <field name="risk_impact"/>
                                    <field name="ncr_id" widget="many2one"/>
                                    <button name="action_create_ncr" string="Generar NCR" type="object" icon="fa-exclamation-triangle" invisible="result != 'non_compliant' or ncr_id != False"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Vista Kanban de Auditorías agrupadas por CDO -->
    <record id="view_iso_audit_kanban" model="ir.ui.view">
        <field name="name">iso.audit.kanban</field>
        <field name="model">iso.audit</field>
        <field name="arch" type="xml">
            <kanban default_group_by="cdo_id" class="o_kanban_mobile">
                <field name="name"/>
                <field name="global_compliance_rate"/>
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="row">
                                <div class="col-8"><strong><field name="name"/></strong></div>
                                <div class="col-4 text-end"><field name="state" widget="badge"/></div>
                            </div>
                            <div><span>Proc: </span><field name="procedure_name"/></div>
                            <div class="mt-2">
                                <strong>Cumplimiento: </strong>
                                <span t-attf-class="#{record.global_compliance_rate.raw_value &gt;= 0.8 ? 'text-success' : 'text-danger'}">
                                    <field name="global_compliance_rate" widget="percentage"/>
                                </span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
</odoo>
