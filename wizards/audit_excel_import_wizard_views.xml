<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_audit_excel_import_wizard_form" model="ir.ui.view">
        <field name="name">audit.excel.import.wizard.form</field>
        <field name="model">audit.excel.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Cargar Auditoría desde Excel">
                <p class="text-muted">
                    Seleccione el archivo <code>.xlsx</code> de auditoría completado (Formato F-CAL-15_R01).
                    El sistema extraerá los metadatos, los 34 reactivos, calculará la ponderación 30/70 y abrirá automáticamente las No Conformidades detectadas.
                </p>
                <group>
                    <field name="excel_file" filename="filename"/>
                    <field name="filename" invisible="1"/>
                </group>
                <footer>
                    <button name="action_import_excel" string="Procesar e Importar" type="object" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_audit_excel_import_wizard" model="ir.actions.act_window">
        <field name="name">Importar Auditoría Excel</field>
        <field name="res_model">audit.excel.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
