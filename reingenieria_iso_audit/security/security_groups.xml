<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 1. Categoría de Módulo -->
    <record id="module_category_reingenieria" model="ir.module.category">
        <field name="name">Reingeniería de Procedimientos</field>
        <field name="sequence">20</field>
    </record>

    <!-- 2. Privilegio de Seguridad (Requerido en Odoo 19.0) -->
    <record id="res_groups_privilege_reingenieria" model="res.groups.privilege">
        <field name="name">Reingeniería ISO</field>
        <field name="category_id" ref="module_category_reingenieria"/>
    </record>

    <!-- 3. Grupos vinculados mediante privilege_id -->
    <record id="group_audit_user" model="res.groups">
        <field name="name">Auditor / Operador CDO</field>
        <field name="privilege_id" ref="res_groups_privilege_reingenieria"/>
    </record>

    <record id="group_audit_manager" model="res.groups">
        <field name="name">Líder de Reingeniería / SGC</field>
        <field name="privilege_id" ref="res_groups_privilege_reingenieria"/>
        <field name="implied_ids" eval="[(4, ref('group_audit_user'))]"/>
    </record>
</odoo>
