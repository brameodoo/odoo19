<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Reporte PDF de Auditoría Interna -->
    <record id="action_report_iso_audit" model="ir.actions.report">
        <field name="name">Informe de Auditoría Interna (F-CAL-15)</field>
        <field name="model">iso.audit</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">reingenieria_iso_audit.report_iso_audit_document</field>
        <field name="report_file">reingenieria_iso_audit.report_iso_audit_document</field>
        <field name="print_report_name">'Informe_Auditoria_%s' % (object.name.replace('/', '_'))</field>
        <field name="binding_model_id" ref="model_iso_audit"/>
        <field name="binding_type">report</field>
    </record>

    <!-- Reporte PDF de No Conformidad (NCR) -->
    <record id="action_report_quality_ncr" model="ir.actions.report">
        <field name="name">Reporte de No Conformidad y CAPA (NCR)</field>
        <field name="model">quality.ncr</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">reingenieria_iso_audit.report_quality_ncr_document</field>
        <field name="report_file">reingenieria_iso_audit.report_quality_ncr_document</field>
        <field name="print_report_name">'NCR_%s' % (object.name.replace('/', '_'))</field>
        <field name="binding_model_id" ref="model_quality_ncr"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
