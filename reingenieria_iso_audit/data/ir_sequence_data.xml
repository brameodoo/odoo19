<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Secuencia de Auditorías Internas -->
        <record id="seq_iso_audit" model="ir.sequence">
            <field name="name">Folio Auditoría ISO</field>
            <field name="code">iso.audit.seq</field>
            <field name="prefix">AUD/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Secuencia de No Conformidades (NCR) -->
        <record id="seq_quality_ncr" model="ir.sequence">
            <field name="name">Folio No Conformidad (NCR)</field>
            <field name="code">quality.ncr.seq</field>
            <field name="prefix">NCR/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Secuencia de Acciones Correctivas (CAPA) -->
        <record id="seq_quality_capa" model="ir.sequence">
            <field name="name">Folio CAPA</field>
            <field name="code">quality.capa.seq</field>
            <field name="padding">4</field>
            <field name="prefix">CAPA/%(year)s/</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
