<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ===================================================== -->
    <!--  CONTADOR EN HOME DEL PORTAL (/my)                  -->
    <!-- ===================================================== -->

    <template id="portal_my_home_custodia"
              inherit_id="portal.portal_my_home"
              name="Custodia Portal Home">

        <xpath expr="//div[@id='portal_content']" position="inside">

            <div class="col-12 col-md-6 col-lg-4 mb-4">
                <a href="/mis-servicios" class="text-decoration-none">
                    <div class="card shadow-sm h-100">
                        <div class="card-body text-center">
                            <img src="/web/static/img/icons/briefcase.svg"
                                 style="width:48px; margin-bottom:10px;"/>
                            <h5>Servicios de Custodia</h5>
                            <p class="text-muted mb-0">
                                Consulta tus servicios activos
                            </p>
                        </div>
                    </div>
                </a>
            </div>

        </xpath>

    </template>


    <!-- ===================================================== -->
    <!--  LISTADO DE SERVICIOS (/mis-servicios)               -->
    <!-- ===================================================== -->

    <template id="portal_my_services"
              name="Mis Servicios">

        <t t-call="portal.portal_layout">
            <div class="container mt-4">
                <h2>Mis Servicios</h2>

                <t t-if="services">
                    <table class="table table-hover mt-3">
                        <thead>
                            <tr>
                                <th>Servicio</th>
                                <th>Fecha</th>
                                <th>Estado</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="services" t-as="service">
                                <tr>
                                    <td>
                                        <a t-att-href="'/mis-servicios/%s' % service.id">
                                            <t t-esc="service.name"/>
                                        </a>
                                    </td>
                                    <td>
                                        <t t-esc="service.fecha_servicio or ''"/>
                                    </td>
                                    <td>
                                        <t t-esc="service.state"/>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </t>

                <t t-if="not services">
                    <div class="alert alert-info mt-3">
                        No tienes servicios registrados.
                    </div>
                </t>

            </div>
        </t>

    </template>


    <!-- ===================================================== -->
    <!--  DETALLE DEL SERVICIO (/mis-servicios/<id>)          -->
    <!-- ===================================================== -->

    <template id="portal_service_detail"
              name="Detalle Servicio Custodia">

        <t t-call="portal.portal_layout">
            <div class="container mt-4">

                <h2>
                    Servicio:
                    <t t-esc="service.name"/>
                </h2>

                <div class="row mt-4">

                    <div class="col-md-6">
                        <h5>Información General</h5>

                        <p><strong>Cliente:</strong>
                            <t t-esc="service.partner_id.name"/>
                        </p>

                        <p><strong>Fecha Planeada:</strong>
                            <t t-esc="service.fecha_servicio"/>
                        </p>

                        <p><strong>Hora Planeada:</strong>
                            <t t-esc="service.hora_planeada"/>
                        </p>

                        <p><strong>Estado:</strong>
                            <t t-esc="service.state"/>
                        </p>
                    </div>

                </div>

            </div>
        </t>

    </template>

</odoo>
